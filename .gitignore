# ---------------------------------------------------------------- secrets
# Signing material must never reach a remote. The Gradle build reads
# android/key.properties when it exists and falls back to debug keys when it
# does not, so a fresh clone still builds without it.
**/key.properties
*.jks
*.keystore
*.p12
*.mobileprovision
*.cer
.env

# ------------------------------------------------------------ build output
# Regenerated by `flutter build`; several gigabytes and useless in history.
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/generated_plugin_registrant.dart

# Android
app/android/.gradle/
app/android/local.properties
app/android/captures/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
*.apk
*.aab
*.iml

# iOS — CocoaPods artefacts are resolved on macOS, so they are not committed.
# `pod install` recreates them from the Podfile.
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/App.framework
app/ios/Flutter/ephemeral/
app/ios/Flutter/flutter_export_environment.sh
app/ios/Flutter/Generated.xcconfig
**/xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# ------------------------------------------------------------------ editors
.idea/
.vscode/
*.swp
*~

# -------------------------------------------------------------------- OS
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------ artwork
# The originals the tree and icon art were cut from — 30 MB of JPGs that no
# build reads. What the app actually ships is app/assets/tree/, which is
# tracked. Keep these locally; they do not belong in every clone.
art_in/
icon_preview.png
